{
  "version": 1,
  "rules": [
    {
      "name": "Quick Start en onboarding",
      "source_patterns": [
        "openquatt/web/js/src/features/quickstart*.js",
        "openquatt/web/js/src/core/quickstart*.js",
        "openquatt/web/js/src/settings/installation.js"
      ],
      "docs_any_of": [
        "docs/web-app.md",
        "docs/q-edition.md",
        "docs/web-app/quick-start.md",
        "docs/web-app/instellingen.md",
        "docs/web-app/bronnen.md",
        "docs/web-app/energie.md",
        "docs/web-app/diagnose.md",
        "docs/web-app/onderhoud.md",
        "docs/web-app/herstel.md",
        "docs/dagelijks/controleren.md",
        "docs/dagelijks/verwarmen.md",
        "docs/dagelijks/koelen.md"
      ]
    },
    {
      "name": "Web-appschermen",
      "source_patterns": [
        "openquatt/web/js/src/views/*.js"
      ],
      "docs_any_of": [
        "docs/web-app.md",
        "docs/problemen-oplossen.md",
        "docs/web-app/quick-start.md",
        "docs/web-app/instellingen.md",
        "docs/web-app/bronnen.md",
        "docs/web-app/energie.md",
        "docs/web-app/diagnose.md",
        "docs/web-app/onderhoud.md",
        "docs/web-app/herstel.md",
        "docs/dagelijks/controleren.md",
        "docs/dagelijks/verwarmen.md",
        "docs/dagelijks/koelen.md"
      ]
    },
    {
      "name": "Web-appinstellingen",
      "source_patterns": [
        "openquatt/web/js/src/settings/installation.js",
        "openquatt/web/js/src/settings/heating.js",
        "openquatt/web/js/src/settings/cooling.js",
        "openquatt/web/js/src/settings/water.js",
        "openquatt/web/js/src/settings/boiler.js",
        "openquatt/web/js/src/settings/controls.js",
        "openquatt/web/js/src/settings/storage.js",
        "openquatt/web/js/src/settings/integrations.js",
        "openquatt/web/js/src/settings/privacy.js",
        "openquatt/web/js/src/settings/security.js",
        "openquatt/web/js/src/settings/silent.js"
      ],
      "docs_any_of": [
        "docs/web-app.md",
        "docs/instellingen-en-meetwaarden.md",
        "docs/web-app/quick-start.md",
        "docs/web-app/instellingen.md",
        "docs/web-app/bronnen.md",
        "docs/web-app/energie.md",
        "docs/web-app/diagnose.md",
        "docs/web-app/onderhoud.md",
        "docs/web-app/herstel.md",
        "docs/dagelijks/controleren.md",
        "docs/dagelijks/verwarmen.md",
        "docs/dagelijks/koelen.md"
      ]
    },
    {
      "name": "Updates, opslag en beveiliging",
      "source_patterns": [
        "openquatt/web/js/src/features/firmware-update.js",
        "openquatt/web/js/src/features/security-access.js",
        "openquatt/web/js/src/features/storage-history.js"
      ],
      "docs_any_of": [
        "docs/web-app.md",
        "docs/problemen-oplossen.md",
        "docs/web-app/quick-start.md",
        "docs/web-app/instellingen.md",
        "docs/web-app/bronnen.md",
        "docs/web-app/energie.md",
        "docs/web-app/diagnose.md",
        "docs/web-app/onderhoud.md",
        "docs/web-app/herstel.md",
        "docs/dagelijks/controleren.md",
        "docs/dagelijks/verwarmen.md",
        "docs/dagelijks/koelen.md"
      ]
    },
    {
      "name": "Installer en firmwarematrix",
      "source_patterns": [
        "build_targets.yaml",
        "docs/install/install.js",
        "docs/install/index.html",
        "openquatt/connection/*.yaml",
        "openquatt/profiles/*.yaml",
        "openquatt/topology/*.yaml",
        "scripts/build_targets.py"
      ],
      "docs_any_of": [
        "docs/install/index.html",
        "docs/q-edition.md",
        "docs/handmatige-installatie.md"
      ]
    },
    {
      "name": "Regelstrategie\u00ebn en flow",
      "source_patterns": [
        "openquatt/oq_boiler_control.yaml",
        "openquatt/oq_cooling_safety.yaml",
        "openquatt/oq_cooling_strategy.yaml",
        "openquatt/oq_flow_autotune.yaml",
        "openquatt/oq_flow_control.yaml",
        "openquatt/oq_heating_curve_strategy.yaml",
        "openquatt/oq_power_house_strategy.yaml",
        "openquatt/oq_thermal_request_control.yaml",
        "openquatt/oq_warmup.yaml",
        "openquatt/includes/control/oq_warmup_*.h"
      ],
      "docs_any_of": [
        "docs/verwarmen-en-koelen.md",
        "docs/power-house.md",
        "docs/water-temperature-control.md",
        "docs/regelgedrag-van-openquatt.md",
        "docs/problemen-oplossen.md",
        "docs/web-app/instellingen.md",
        "docs/dagelijks/verwarmen.md"
      ]
    },
    {
      "name": "Gebruikersentiteiten en instellingen",
      "source_patterns": [
        "openquatt/oq_common.yaml",
        "openquatt/oq_substitutions_common.yaml"
      ],
      "docs_any_of": [
        "docs/instellingen-en-meetwaarden.md",
        "docs/dashboard/README.md",
        "docs/web-app.md",
        "docs/web-app/quick-start.md",
        "docs/web-app/instellingen.md",
        "docs/web-app/bronnen.md",
        "docs/web-app/energie.md",
        "docs/web-app/diagnose.md",
        "docs/web-app/onderhoud.md",
        "docs/web-app/herstel.md",
        "docs/dagelijks/controleren.md",
        "docs/dagelijks/verwarmen.md",
        "docs/dagelijks/koelen.md"
      ]
    },
    {
      "name": "Web-appdemo",
      "source_patterns": [
        "openquatt/web/js/mock-device.js",
        "openquatt/web/js/mock-fixtures.js",
        "openquatt/web/js/mock-scenarios.js"
      ],
      "docs_any_of": [
        "README.md",
        "docs/web-app.md",
        "docs/web-app/quick-start.md",
        "docs/web-app/instellingen.md",
        "docs/web-app/bronnen.md",
        "docs/web-app/energie.md",
        "docs/web-app/diagnose.md",
        "docs/web-app/onderhoud.md",
        "docs/web-app/herstel.md",
        "docs/dagelijks/controleren.md",
        "docs/dagelijks/verwarmen.md",
        "docs/dagelijks/koelen.md"
      ]
    }
  ]
}
